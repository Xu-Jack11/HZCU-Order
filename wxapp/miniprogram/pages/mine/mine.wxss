/**mine.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
}

/* 用户信息头部 */
.user-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 40rpx;
  background: linear-gradient(to right, #3498db, #2ecc71);
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.user-text {
  display: flex;
  flex-direction: column;
}

.login-hint {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.login-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.user-name {
  font-size: 32rpx;
  color: #fff;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.setting-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 订单入口 */
.order-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.view-all {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
  font-weight: normal;
}

.arrow-right {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.order-quick-entry {
  display: flex;
  justify-content: space-around;
}

.entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.entry-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 12rpx;
}

.entry-item text {
  font-size: 24rpx;
  color: #666;
}

.entry-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #e74c3c;
  color: #fff !important;
  font-size: 20rpx !important;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* 功能列表 */
.menu-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 24rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-extra {
  font-size: 24rpx;
  color: #e74c3c;
  margin-right: 16rpx;
}

/* 客服 */
.contact-section {
  padding: 30rpx;
}

.contact-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
}

.contact-btn::after {
  border: none;
}

.contact-icon {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
}
