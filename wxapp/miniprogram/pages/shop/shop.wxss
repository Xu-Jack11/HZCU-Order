/**shop.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 商家头部信息 */
.shop-header {
  display: flex;
  justify-content: space-between;
  background: #fff;
  padding: 30rpx;
}

.shop-info {
  flex: 1;
}

.shop-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.shop-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.shop-actions {
  display: flex;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-left: 20rpx;
}

.shop-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.divider {
  margin: 0 16rpx;
  color: #ddd;
}

.shop-notice {
  font-size: 24rpx;
  color: #999;
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-left: 20rpx;
}

/* 标签页 */
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #3498db;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #3498db;
  border-radius: 2rpx;
}

/* 主内容区 */
.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类 */
.category-sidebar {
  width: 160rpx;
  background: #f5f5f5;
  height: calc(100vh - 350rpx - 120rpx);
}

.category-item {
  padding: 30rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
  position: relative;
}

.category-item.active {
  background: #fff;
  color: #3498db;
  font-weight: bold;
}

.category-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 40rpx;
  background: #3498db;
  border-radius: 3rpx;
}

/* 右侧商品列表 */
.goods-list {
  flex: 1;
  background: #fff;
  height: calc(100vh - 350rpx - 120rpx);
  padding: 0 20rpx;
}

.goods-section {
  padding-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 20rpx 0;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.goods-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.goods-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.goods-sales {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.good-rate {
  margin-left: 20rpx;
}

.goods-tags {
  display: flex;
  margin-bottom: 8rpx;
}

.goods-tag {
  font-size: 20rpx;
  color: #f39c12;
  border: 1rpx solid #f39c12;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  margin-right: 10rpx;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
}

.goods-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  font-size: 24rpx;
  color: #e74c3c;
}

.price-value {
  font-size: 36rpx;
  color: #e74c3c;
  font-weight: bold;
}

.price-original {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-left: 10rpx;
}

.goods-actions {
  display: flex;
  align-items: center;
}

.action-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.action-btn.minus {
  border: 2rpx solid #3498db;
  color: #3498db;
}

.action-btn.plus {
  background: #3498db;
  color: #fff;
}

.goods-count {
  font-size: 28rpx;
  color: #333;
  margin: 0 16rpx;
  min-width: 30rpx;
  text-align: center;
}

/* 评价页 */
.comment-content {
  flex: 1;
  padding: 20rpx;
  overflow-y: auto;
}

.comment-item {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.comment-body {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.comment-name {
  font-size: 26rpx;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-rating {
  margin-bottom: 10rpx;
}

.star {
  color: #f39c12;
  font-size: 24rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

/* 商家信息页 */
.info-content {
  flex: 1;
  padding: 20rpx;
}

.info-item {
  display: flex;
  background: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #666;
  width: 180rpx;
}

.info-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 底部购物车 */
.cart-bar {
  display: flex;
  height: 120rpx;
  background: #2c3e50;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  padding-left: 30rpx;
}

.cart-icon-wrap {
  position: relative;
  width: 90rpx;
  height: 90rpx;
  background: #34495e;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -30rpx;
}

.cart-icon {
  width: 50rpx;
  height: 50rpx;
}

.cart-badge {
  position: absolute;
  top: 0;
  right: 0;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 16rpx;
  padding: 0 6rpx;
}

.cart-price {
  margin-left: 20rpx;
}

.total-price {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.delivery-fee {
  font-size: 22rpx;
  color: #95a5a6;
  display: block;
  margin-top: 4rpx;
}

.cart-right {
  width: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #95a5a6;
  color: #fff;
  font-size: 32rpx;
}

.cart-right.active {
  background: #2ecc71;
}

/* 购物车详情弹窗 */
.cart-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 120rpx;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
}

.cart-detail {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 120rpx;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 60vh;
  z-index: 100;
}

.cart-detail-header {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}

.clear-cart {
  color: #3498db;
}

.cart-detail-list {
  max-height: 50vh;
  padding: 0 30rpx;
}

.cart-detail-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.cart-item-right {
  display: flex;
  align-items: center;
}

.cart-item-price {
  font-size: 28rpx;
  color: #e74c3c;
  margin-right: 30rpx;
}
