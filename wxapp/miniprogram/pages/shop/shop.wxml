<!--shop.wxml-->
<view class="container">
  <!-- 商家头部信息 -->
  <view class="shop-header">
    <view class="shop-info">
      <view class="shop-name-row">
        <text class="shop-name">{{shopInfo.name}}</text>
        <view class="shop-actions">
          <image class="action-icon" src="/images/heart.png" mode="aspectFit" bindtap="toggleFavorite"></image>
          <image class="action-icon" src="/images/warning.png" mode="aspectFit" bindtap="showWarning"></image>
        </view>
      </view>
      <view class="shop-meta">
        <text>预计{{shopInfo.waitTime}}分钟</text>
        <text class="divider">|</text>
        <text>月售{{shopInfo.monthlySales}}</text>
      </view>
      <view class="shop-notice">
        <text>公告：{{shopInfo.notice}}</text>
      </view>
    </view>
    <image class="shop-logo" src="{{shopInfo.logo}}" mode="aspectFill"></image>
  </view>

  <!-- 标签页切换 -->
  <view class="tabs">
    <view class="tab {{currentTab === 'menu' ? 'active' : ''}}" bindtap="switchTab" data-tab="menu">点餐</view>
    <view class="tab {{currentTab === 'comment' ? 'active' : ''}}" bindtap="switchTab" data-tab="comment">评价</view>
    <view class="tab {{currentTab === 'info' ? 'active' : ''}}" bindtap="switchTab" data-tab="info">商家</view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content" wx:if="{{currentTab === 'menu'}}">
    <!-- 左侧分类 -->
    <scroll-view class="category-sidebar" scroll-y>
      <view 
        class="category-item {{activeCategory === index ? 'active' : ''}}" 
        wx:for="{{categories}}" 
        wx:key="id"
        bindtap="selectCategory"
        data-index="{{index}}"
      >
        {{item.name}}
      </view>
    </scroll-view>

    <!-- 右侧商品列表 -->
    <scroll-view class="goods-list" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
      <view class="goods-section" wx:for="{{categories}}" wx:key="id" id="category-{{index}}">
        <view class="section-title">{{item.name}}</view>
        <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="id">
          <image class="goods-image" src="{{goods.image}}" mode="aspectFill"></image>
          <view class="goods-info">
            <view class="goods-name">{{goods.name}}</view>
            <view class="goods-desc">{{goods.description}}</view>
            <view class="goods-sales">
              <text>月售{{goods.monthlySales}}</text>
              <text class="good-rate">好评率{{goods.goodRate}}%</text>
            </view>
            <view class="goods-tags" wx:if="{{goods.tags.length > 0}}">
              <text class="goods-tag" wx:for="{{goods.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <view class="goods-price-row">
              <view class="goods-price">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{goods.price}}</text>
                <text class="price-original" wx:if="{{goods.originalPrice}}">¥{{goods.originalPrice}}</text>
              </view>
              <view class="goods-actions">
                <view class="action-btn minus" wx:if="{{goods.count > 0}}" catchtap="decreaseGoods" data-id="{{goods.id}}">
                  <text>-</text>
                </view>
                <text class="goods-count" wx:if="{{goods.count > 0}}">{{goods.count}}</text>
                <view class="action-btn plus" catchtap="increaseGoods" data-id="{{goods.id}}">
                  <text>+</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 评价页 -->
  <view class="comment-content" wx:if="{{currentTab === 'comment'}}">
    <view class="comment-item" wx:for="{{comments}}" wx:key="id">
      <image class="comment-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="comment-body">
        <view class="comment-header">
          <text class="comment-name">{{item.nickname}}</text>
          <text class="comment-time">{{item.time}}</text>
        </view>
        <view class="comment-rating">
          <text class="star" wx:for="{{5}}" wx:key="*this">{{index < item.rating ? '★' : '☆'}}</text>
        </view>
        <view class="comment-text">{{item.content}}</view>
      </view>
    </view>
  </view>

  <!-- 商家信息页 -->
  <view class="info-content" wx:if="{{currentTab === 'info'}}">
    <view class="info-item">
      <text class="info-label">商家名称</text>
      <text class="info-value">{{shopInfo.name}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">商家地址</text>
      <text class="info-value">{{shopInfo.address}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">营业时间</text>
      <text class="info-value">{{shopInfo.businessHours}}</text>
    </view>
    <view class="info-item">
      <text class="info-label">联系电话</text>
      <text class="info-value">{{shopInfo.phone}}</text>
    </view>
  </view>

  <!-- 底部购物车 -->
  <view class="cart-bar" wx:if="{{currentTab === 'menu'}}">
    <view class="cart-left" bindtap="showCartDetail">
      <view class="cart-icon-wrap">
        <image class="cart-icon" src="/images/cart.png" mode="aspectFit"></image>
        <text class="cart-badge" wx:if="{{totalCount > 0}}">{{totalCount}}</text>
      </view>
      <view class="cart-price">
        <text class="total-price">¥{{totalPrice}}</text>
      </view>
    </view>
    <view class="cart-right {{canCheckout ? 'active' : ''}}" bindtap="goCheckout">
      去结算
    </view>
  </view>

  <!-- 购物车详情弹窗 -->
  <view class="cart-detail-mask" wx:if="{{showCartDetail}}" bindtap="hideCartDetail"></view>
  <view class="cart-detail" wx:if="{{showCartDetail}}">
    <view class="cart-detail-header">
      <text>已选商品</text>
      <text class="clear-cart" bindtap="clearCart">清空</text>
    </view>
    <scroll-view class="cart-detail-list" scroll-y>
      <view class="cart-detail-item" wx:for="{{cartList}}" wx:key="id">
        <text class="cart-item-name">{{item.name}}</text>
        <view class="cart-item-right">
          <text class="cart-item-price">¥{{item.price}}</text>
          <view class="goods-actions">
            <view class="action-btn minus" catchtap="decreaseGoods" data-id="{{item.id}}">
              <text>-</text>
            </view>
            <text class="goods-count">{{item.count}}</text>
            <view class="action-btn plus" catchtap="increaseGoods" data-id="{{item.id}}">
              <text>+</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
