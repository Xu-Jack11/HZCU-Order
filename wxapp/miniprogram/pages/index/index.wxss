/**index.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 顶部地址栏 */
.header {
  background: linear-gradient(to right, #3498db, #2ecc71);
  padding: 20rpx 30rpx;
  padding-top: 60rpx;
}

.location {
  display: flex;
  align-items: center;
}

.location-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.location-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.arrow-icon {
  width: 24rpx;
  height: 24rpx;
  margin-left: 10rpx;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: linear-gradient(to right, #3498db, #2ecc71);
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 30rpx;
  padding: 16rpx 24rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.placeholder {
  color: #999;
}

.search-btn {
  color: #fff;
  font-size: 28rpx;
  margin-left: 20rpx;
  padding: 16rpx 30rpx;
  background: #f39c12;
  border-radius: 30rpx;
}

/* 分类导航 */
.category-scroll {
  background: #fff;
  white-space: nowrap;
}

.category-list {
  display: flex;
  padding: 20rpx 0;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 30rpx;
  min-width: 120rpx;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #333;
}

/* 筛选标签 */
.filter-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.filter-tab {
  font-size: 28rpx;
  color: #666;
  margin-right: 40rpx;
  padding-bottom: 10rpx;
}

.filter-tab.active {
  color: #3498db;
  border-bottom: 4rpx solid #3498db;
  font-weight: bold;
}

/* 商家列表 */
.shop-list {
  flex: 1;
  padding: 20rpx;
}

.shop-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.shop-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.shop-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.shop-meta {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.shop-rating {
  color: #f39c12;
  margin-right: 16rpx;
}

.shop-sales, .shop-time, .shop-distance {
  margin-right: 16rpx;
}

.shop-delivery {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.shop-delivery text {
  margin-right: 16rpx;
}

.shop-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #e74c3c;
  border: 1rpx solid #e74c3c;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  margin-right: 12rpx;
  margin-top: 6rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}
