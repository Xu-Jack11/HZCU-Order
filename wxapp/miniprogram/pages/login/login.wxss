.container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #fff;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 80rpx;
  color: #333;
}

/* 微信登录按钮 */
.btn-wechat {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #fff;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}


/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 60rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: #e5e5e5;
}

.divider-text {
  margin: 0 30rpx;
  font-size: 28rpx;
  color: #999;
}

/* 手机号登录区域 */
.phone-login {
  margin-top: 40rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 44rpx;
  padding: 0 30rpx;
  margin-bottom: 40rpx;
  font-size: 30rpx;
  background: #f8f8f8;
  box-sizing: border-box;
}

.input:focus {
  border-color: #07c160;
  background: #fff;
}

/* 通用按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  background: #007AFF;
  color: #fff;
  border: none;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn:disabled {
  background: #ccc;
}

/* 登录提示 */
.login-tips {
  text-align: center;
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.login-tips text {
  color: #07c160;
}
