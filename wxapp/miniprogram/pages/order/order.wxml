<!--order.wxml-->
<view class="container">
  <!-- 订单状态筛选 -->
  <view class="order-tabs">
    <view class="order-tab {{activeStatus === 'all' ? 'active' : ''}}" bindtap="switchStatus" data-status="all">全部</view>
    <view class="order-tab {{activeStatus === 'pending' ? 'active' : ''}}" bindtap="switchStatus" data-status="pending">待付款</view>
    <view class="order-tab {{activeStatus === 'paid' ? 'active' : ''}}" bindtap="switchStatus" data-status="paid">待配送</view>
    <view class="order-tab {{activeStatus === 'delivering' ? 'active' : ''}}" bindtap="switchStatus" data-status="delivering">配送中</view>
    <view class="order-tab {{activeStatus === 'completed' ? 'active' : ''}}" bindtap="switchStatus" data-status="completed">已完成</view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y bindscrolltolower="loadMore">
    <view class="order-item" wx:for="{{orderList}}" wx:key="id" bindtap="goOrderDetail" data-id="{{item.id}}">
      <!-- 商家信息 -->
      <view class="order-shop">
        <image class="shop-logo" src="{{item.shopLogo}}" mode="aspectFill"></image>
        <text class="shop-name">{{item.shopName}}</text>
        <text class="order-status {{item.status}}">{{item.statusText}}</text>
      </view>

      <!-- 商品列表 -->
      <view class="order-goods">
        <view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:key="id">
          <image class="goods-image" src="{{goods.image}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{goods.name}}</text>
            <text class="goods-count">x{{goods.count}}</text>
          </view>
          <text class="goods-price">¥{{goods.price}}</text>
        </view>
      </view>

      <!-- 订单金额 -->
      <view class="order-total">
        <text>共{{item.totalCount}}件商品</text>
        <text class="total-price">实付：<text class="price">¥{{item.totalPrice}}</text></text>
      </view>

      <!-- 订单操作 -->
      <view class="order-actions">
        <view class="action-btn" wx:if="{{item.status === 'pending'}}" catchtap="cancelOrder" data-id="{{item.id}}">取消订单</view>
        <view class="action-btn primary" wx:if="{{item.status === 'pending'}}" catchtap="payOrder" data-id="{{item.id}}">去付款</view>
        <view class="action-btn" wx:if="{{item.status === 'completed'}}" catchtap="reOrder" data-id="{{item.id}}">再来一单</view>
        <view class="action-btn primary" wx:if="{{item.status === 'completed'}}" catchtap="commentOrder" data-id="{{item.id}}">去评价</view>
        <view class="action-btn primary" wx:if="{{item.status === 'delivering'}}" catchtap="confirmReceive" data-id="{{item.id}}">确认收货</view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orderList.length === 0 && !loading}}">
      <image class="empty-icon" src="/images/empty-order.png" mode="aspectFit"></image>
      <text class="empty-text">暂无订单</text>
      <view class="empty-btn" bindtap="goHome">去点餐</view>
    </view>

    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{noMore && orderList.length > 0}}">没有更多了</view>
  </scroll-view>
</view>
