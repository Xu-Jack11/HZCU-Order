/**order.wxss**/
page {
  height: 100vh;
  background-color: var(--bg-color, #F7F8FA);
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 订单状态筛选 */
.order-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 0 10rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  position: sticky;
  top: 0;
  z-index: 10;
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub, #666);
  padding: 24rpx 0;
  position: relative;
  transition: all 0.3s;
}

.order-tab.active {
  color: var(--primary-color, #007AFF);
  font-weight: 600;
  font-size: 30rpx;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--primary-color, #007AFF);
  border-radius: 4rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box; /* Ensure padding doesn't cause overflow */
  width: 100%;
}

.order-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.04));
}

/* 商家信息 */
.order-shop {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #F5F6F8;
}

.shop-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #eee;
}

.shop-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-main, #333);
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  font-size: 26rpx;
  color: var(--text-light, #999);
  font-weight: 500;
}

.order-status.pending {
  color: #FF9500;
}

.order-status.paid,
.order-status.delivering {
  color: var(--primary-color, #007AFF);
}

.order-status.completed {
  color: var(--text-sub, #666);
}

/* 商品列表 */
.order-goods {
  padding: 16rpx 24rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.goods-image {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f9f9f9;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden; /* Prevent text overflow */
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main, #333);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-count {
  font-size: 24rpx;
  color: var(--text-light, #999);
}

.goods-price {
  font-size: 28rpx;
  color: var(--text-main, #333);
  font-weight: 500;
}

/* 订单金额 */
.order-total {
  display: flex;
  justify-content: flex-end; /* Align to right */
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #F5F6F8;
  font-size: 26rpx;
  color: var(--text-main, #333);
}

.order-total text {
  margin-left: 12rpx;
}

.total-price .price {
  color: var(--text-main, #333);
  font-weight: 600;
  font-size: 32rpx;
}

/* 订单操作 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  /* border-top: 1rpx solid #F5F6F8;  Removed double border look */
}

.action-btn {
  padding: 14rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  border: 1rpx solid #E5E5E5;
  color: var(--text-main, #333);
  min-width: 140rpx;
  text-align: center;
  box-sizing: border-box;
}

.action-btn.primary {
  background: var(--primary-color, #007AFF);
  color: #fff;
  border-color: var(--primary-color, #007AFF);
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.2);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 32rpx;
  opacity: 0.8;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-light, #999);
  margin-bottom: 48rpx;
}

.empty-btn {
  padding: 20rpx 80rpx;
  background: var(--primary-color, #007AFF);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.3);
}

.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: var(--text-light, #999);
  font-size: 24rpx;
}
