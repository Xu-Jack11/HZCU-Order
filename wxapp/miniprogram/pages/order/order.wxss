/**order.wxss**/
page {
  height: 100vh;
  background-color: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 订单状态筛选 */
.order-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.order-tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 16rpx 0;
  position: relative;
}

.order-tab.active {
  color: #3498db;
  font-weight: bold;
}

.order-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #3498db;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  flex: 1;
  padding: 20rpx;
}

.order-item {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

/* 商家信息 */
.order-shop {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.shop-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.shop-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.order-status {
  font-size: 26rpx;
  color: #999;
}

.order-status.pending {
  color: #e74c3c;
}

.order-status.paid,
.order-status.delivering {
  color: #3498db;
}

.order-status.completed {
  color: #2ecc71;
}

/* 商品列表 */
.order-goods {
  padding: 16rpx 24rpx;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.goods-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.goods-count {
  font-size: 24rpx;
  color: #999;
}

.goods-price {
  font-size: 26rpx;
  color: #e74c3c;
}

/* 订单金额 */
.order-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 26rpx;
  color: #666;
}

.total-price {
  color: #333;
}

.total-price .price {
  color: #e74c3c;
  font-weight: bold;
  font-size: 30rpx;
}

/* 订单操作 */
.order-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-left: 20rpx;
  border: 1rpx solid #ddd;
  color: #666;
}

.action-btn.primary {
  background: #3498db;
  color: #fff;
  border-color: #3498db;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  background: #3498db;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.loading, .no-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 26rpx;
}
