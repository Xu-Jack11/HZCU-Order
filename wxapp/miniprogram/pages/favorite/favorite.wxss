/* favorite.wxss */
page {
  background: #f7f8fa;
  height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.clear-btn {
  font-size: 26rpx;
  color: #ff4d6a;
  padding: 10rpx 20rpx;
  background: rgba(255, 77, 106, 0.08);
  border-radius: 20rpx;
}

.favorite-list {
  flex: 1;
  padding: 24rpx 24rpx 40rpx;
  box-sizing: border-box;
}

.favorite-item {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.shop-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

.shop-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.shop-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.shop-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.tag {
  font-size: 20rpx;
  color: #ff7f50;
  background: rgba(255, 127, 80, 0.12);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.shop-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.divider {
  color: #ddd;
}

.action {
  padding: 10rpx 20rpx;
  color: #ff4d6a;
  border: 1rpx solid rgba(255, 77, 106, 0.4);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.empty {
  padding: 120rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
}

.empty-img {
  width: 260rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 26rpx;
  margin-bottom: 20rpx;
}

.go-home {
  background: #007aff;
  color: #fff;
  border-radius: 40rpx;
  padding: 12rpx 40rpx;
}
