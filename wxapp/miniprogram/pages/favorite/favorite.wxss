page {
  background: #f7f8fa;
  height: 100vh;
}

.container {
  height: 100vh;
  padding: 24rpx 32rpx calc(env(safe-area-inset-bottom) + 24rpx);
  box-sizing: border-box;
}

.fav-list {
  height: 100%;
}

.fav-item {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 8rpx rgba(0, 0, 0, 0.05));
}

.fav-logo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background-color: #f2f2f2;
}

.fav-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.fav-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.fav-meta {
  font-size: 24rpx;
  color: #666;
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.dot {
  margin: 0 12rpx;
  color: #ccc;
}

.fav-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  color: #FF6B00;
  background: rgba(255, 107, 0, 0.1);
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}

.fav-actions {
  display: flex;
  margin-top: 16rpx;
}

.action-btn {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--primary-color, #007AFF);
  background: rgba(0, 122, 255, 0.1);
  margin-right: 16rpx;
}

.action-btn.danger {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.08);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 80vh;
  color: #999;
}

.empty-icon {
  width: 260rpx;
  height: 260rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.primary-btn {
  padding: 16rpx 48rpx;
  background: var(--primary-color, #007AFF);
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, 0.25);
}
